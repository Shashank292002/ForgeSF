# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
.vite/
build/

# Tauri / Rust build artifacts. `target/` matches at any depth, which covers
# apps/desktop/src-tauri/target as well.
target/

# Test and tooling caches
coverage/
.turbo/
.eslintcache
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / local configuration
.env
.env.*
!.env.example

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.old

# Merge and patch leftovers, which are never meant to be committed
*.orig
*.rej

# Local Salesforce development workspaces
apps/desktop/workspace/

# Salesforce CLI project-local state (metadata catalog, config). The CLI writes
# it into its working directory, which was wherever ForgeSF was launched from.
.sf/
.sfdx/

# Stray workspace created at the repo root by the old CWD-dependent
# workspace resolution (see get_workspace in src-tauri/src/workspace/registry.rs).
/workspace/
